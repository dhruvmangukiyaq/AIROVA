# --- Database -------------------------------------------------------------
# Local SQLite (default). For Vercel/Supabase use a postgres URL instead:
# DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"
DATABASE_URL="file:./dev.db"

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AIROVA FOOTWEAR"
# Secret used to sign session cookies + verify webhooks. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-openssl-rand-base64-32"

# --- Razorpay (test keys: https://dashboard.razorpay.com/app/keys) --------
# Leave the key empty to run in "simulate" mode (no real gateway calls).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Store behaviour ------------------------------------------------------
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=2999
NEXT_PUBLIC_SHIPPING_FEE=99
NEXT_PUBLIC_EXPRESS_SHIPPING_FEE=199
NEXT_PUBLIC_COD_FEE=0

# --- Analytics placeholders (fill to enable) ------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Email (order confirmation) -------------------------------------------
# Leave RESEND_API_KEY empty to log the rendered email to the dev console.
RESEND_API_KEY=""
EMAIL_FROM="AIROVA FOOTWEAR <orders@airova.in>"
# Optional SMTP fallback (swap src/lib/mailer.ts to use these):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- WhatsApp / social ----------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/airova.footwear"
